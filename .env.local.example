# Supabase project URL — found in your Supabase dashboard under Settings > API
SUPABASE_URL=

# Service role key — found in Settings > API > Project API keys
# Keep this secret. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# API key required by POST /api/match
# Generate a random secret, e.g.: openssl rand -hex 32
MATCH_API_KEY=

# API key required by POST /api/recruiter/match and GET /api/company-needs (recruiter dashboard)
# Generate a random secret, e.g.: openssl rand -hex 32
RECRUITER_API_KEY=

# Same value as RECRUITER_API_KEY — exposed to the browser by the recruiter dashboard
# Temporary MVP auth. Replace with session-based auth before real production use.
NEXT_PUBLIC_RECRUITER_API_KEY=
