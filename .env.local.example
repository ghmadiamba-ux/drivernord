# Supabase project URL — found in your Supabase dashboard under Settings > API
SUPABASE_URL=

# Service role key — found in Settings > API > Project API keys
# Keep this secret. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# API key required by POST /api/match
# Generate a random secret, e.g.: openssl rand -hex 32
MATCH_API_KEY=

# API key for recruiter dashboard login and all /api/cockpit/* + /api/company-needs routes.
# Generate a random secret, e.g.: openssl rand -hex 32
# The cockpit UI uses HTTP-only cookie auth — this key is never sent to the browser.
RECRUITER_API_KEY=

# Cron job auth key — required by POST /api/agent/follow-up (Vercel cron).
# Passed as header: x-api-key: <value>
# Generate a random secret, e.g.: openssl rand -hex 32
AGENT_API_KEY=
