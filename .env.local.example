# ─── Meta Pixel (browser-side tracking) ──────────────────────────────────────
#
# Pixel name:   DriverNord - Chauffeurs SE
# Pixel ID:     1011051371582313
# Dataset:      Created in Meta Events Manager
#
# Default: disabled. Set NEXT_PUBLIC_META_PIXEL_ENABLED=true ONLY after:
#   1. Cookie consent banner is implemented and live
#   2. Swedish GDPR lawyer has confirmed the legal basis for Pixel tracking
#   3. Pixel has been tested locally with Meta Test Events tool
#   4. Founder has explicitly authorized production activation
#
# The Pixel ID is not a secret (it is visible in browser source), but keeping
# it in an env var allows per-environment control without code changes.
#
NEXT_PUBLIC_META_PIXEL_ID=1011051371582313
NEXT_PUBLIC_META_PIXEL_ENABLED=false

# ─── Supabase ─────────────────────────────────────────────────────────────────

# Supabase project URL — found in your Supabase dashboard under Settings > API
SUPABASE_URL=

# Service role key — found in Settings > API > Project API keys
# Keep this secret. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# API key required by POST /api/match
# Generate a random secret, e.g.: openssl rand -hex 32
MATCH_API_KEY=

# API key for recruiter dashboard login and all /api/cockpit/* + /api/company-needs routes.
# Generate a random secret, e.g.: openssl rand -hex 32
# The cockpit UI uses HTTP-only cookie auth — this key is never sent to the browser.
RECRUITER_API_KEY=

# Cron job auth key — required by POST /api/agent/follow-up (Vercel cron).
# Passed as header: x-api-key: <value>
# Generate a random secret, e.g.: openssl rand -hex 32
AGENT_API_KEY=

# ─── SMS messaging provider ──────────────────────────────────────────────────
#
# Default behavior: if SMS_PROVIDER is not set, all sends are SIMULATED
# (console.log only — no network calls, no real messages sent).
#
# To enable real SMS delivery:
#   1. Choose a provider (currently supported: 46elks)
#   2. Set SMS_PROVIDER to the provider name
#   3. Set SMS_API_KEY, SMS_API_SECRET, SMS_FROM_NUMBER
#
# 46elks (https://46elks.com — recommended for Swedish numbers):
#   SMS_PROVIDER=46elks
#   SMS_API_KEY=     # your 46elks API username
#   SMS_API_SECRET=  # your 46elks API password
#   SMS_FROM_NUMBER= # registered sender number or alphanumeric sender ID
#
# WhatsApp: not yet implemented — reserved for a future provider.
# Keep these blank in development to use simulation mode.
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# ─── Community / Logistikklubb ────────────────────────────────────────────────
# WhatsApp community invite link — public, safe to commit the URL (it's a public join link)
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/HC2QY2W32CYIIXpxawXSOG

# ─── Founder notification relay (Logistikklubb post-due alerts) ───────────────
#
# Email relay (activate immediately — uses existing Zoho SMTP):
#   FOUNDER_NOTIFICATIONS_ENABLED=true
#   FOUNDER_NOTIFICATION_EMAIL=hej@drivernord.com
#   ZOHO_SMTP_PASSWORD=<zoho-app-password>   ← Zoho Mail → Settings → Security → App Passwords
#   ZOHO_FROM_EMAIL=hej@drivernord.com       ← already the default
#   ZOHO_FROM_NAME=DriverNord                ← already the default
#
# When a post is due, the system sends the full post text to the configured email.
# The email includes the copy-ready post text and a link to the admin cockpit.
# No drivers, no companies, no group are contacted by this notification.
#
FOUNDER_NOTIFICATIONS_ENABLED=false
FOUNDER_NOTIFICATION_EMAIL=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=hej@drivernord.com
ZOHO_FROM_NAME=DriverNord

# ─── WhatsApp relay — Meta Cloud API (future phase) ──────────────────────────
#
# Relay pattern: a Meta Cloud API sender number → company WhatsApp number.
# The company number (+46 70 938 52 67) stays in WhatsApp Business app (no migration).
# A SEPARATE registered Cloud API sender number provides the WHATSAPP_PHONE_NUMBER_ID.
# Set WHATSAPP_FOUNDER_PHONE to the company number (46709385267, no '+').
#
# DO NOT ACTIVATE until:
#   1. A Meta Business Account (MBA) is set up for DriverNord
#   2. A WhatsApp Business Account (WABA) is registered under the MBA
#   3. A sender number is registered and verified with Meta (NOT the company number)
#   4. The logistikklubb_post_due message template is approved by Meta
#   5. Founder explicitly authorizes activation
#
FOUNDER_WHATSAPP_ENABLED=false
WHATSAPP_FOUNDER_PHONE=46709385267
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=logistikklubb_post_due
WHATSAPP_TEMPLATE_LANGUAGE=sv
WHATSAPP_MAX_DAILY=10

# ─── Facebook Page publishing — Graph API ─────────────────────────────────────
#
# Enables autonomous text posting to the DriverNord Facebook Page.
# The cron at /api/cron/logistikklubb-scheduler (06:00 UTC daily) posts
# any approved+scheduled Logistikklubb posts to the Page automatically.
#
# DO NOT SET FACEBOOK_PAGE_API_ENABLED=true until ALL of the following are done:
#   1. Facebook Page connected to Meta Business Manager
#   2. A Meta App created with pages_manage_posts + pages_read_engagement permissions
#   3. A long-lived Page Access Token generated (valid ~60 days — must be renewed)
#   4. Token tested with Graph API Explorer: GET /{pageId}?fields=id,name
#   5. CRON_SECRET set in Vercel (required to protect the cron endpoint)
#   6. Founder explicitly authorizes live posting
#
# How to find FACEBOOK_PAGE_ID:
#   Go to your Facebook Page → About → Page transparency → Page ID (numeric)
#   Or from the URL: facebook.com/profile.php?id=<THIS_NUMBER>
#
# How to generate a Page Access Token (long-lived):
#   Meta Business Manager → Business Settings → Accounts → Pages → select page
#   → Assign Partners or: use Graph API Explorer with your Meta App → select Page → generate token
#   Exchange short-lived token for long-lived: GET /oauth/access_token?...
#
# FACEBOOK_API_VERSION defaults to v21.0 in code — only set if you need to override.
# FACEBOOK_MAX_POSTS_PER_DAY defaults to 1 in code — safe to omit.
#
FACEBOOK_PAGE_API_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v21.0
FACEBOOK_MAX_POSTS_PER_DAY=1

# ─── Cron endpoint security ────────────────────────────────────────────────────
#
# CRON_SECRET protects all /api/cron/* routes from unauthorized external triggers.
# Vercel sends this automatically as "Authorization: Bearer {secret}" when running crons.
# If unset, the cron endpoint accepts any caller — set this before enabling Facebook posting.
# Generate a random secret: openssl rand -hex 32
#
CRON_SECRET=
